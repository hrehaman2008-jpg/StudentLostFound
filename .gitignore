# Virtual environment
venv/
env/
.venv/
ENV/

# Python cache / compiled files
__pycache__/
*.py[cod]
*$py.class
*.so

# Local database (SQLite in the instance folder)
instance/*.db
instance/*.sqlite
instance/*.sqlite3
instance/.DS_Store

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Editor / OS noise
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# Flask instance folder keeps its directory but not local data
instance/*
!instance/.gitkeep
# Uploaded report photographs (keep the folder, ignore the images)
static/uploads/reports/*
!static/uploads/reports/.gitkeep
